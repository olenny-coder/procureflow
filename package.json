{
  "name": "procureflow",
  "version": "0.1.0",
  "private": true,
  "description": "ProcureFlow - procurement intake, policy, approvals, POs and audit with durable workflows",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stock-engine": "node scripts/dev.mjs --stock-engine",
    "dev:reworked-engine": "node scripts/dev.mjs --reworked-engine",
    "build": "pnpm --filter @procureflow/web build",
    "start:web": "pnpm --filter @procureflow/web start",
    "start:worker": "pnpm --filter @procureflow/worker start",
    "lint": "pnpm --filter @procureflow/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run packages/shared",
    "test:workflows": "vitest run packages/workflows",
    "db:generate": "pnpm --filter @procureflow/db generate",
    "db:migrate": "pnpm --filter @procureflow/db migrate",
    "db:seed": "pnpm --filter @procureflow/db seed",
    "db:studio": "pnpm --filter @procureflow/db studio",
    "assistant:dev": "python -m uvicorn app.main:app --reload --port 8001 --app-dir services/assistant",
    "assistant:test": "python -m pytest services/assistant/tests -q",
    "assistant:calibrate": "python services/assistant/calibration.py",
    "engine:build": "node scripts/engine-build.mjs",
    "engine:dev": "node scripts/engine-dev.mjs",
    "engine:dev:stock": "node scripts/stock-engine.mjs",
    "engine:check": "node scripts/check-vendor-mods.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/node": "20.19.43",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
