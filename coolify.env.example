# Copy these values into Coolify's Environment tab for the Docker Compose resource.
# Do not commit a filled-in copy.
#
# AUTH_SECRET and INTERNAL_API_TOKEN are optional: if omitted, the web entrypoint
# generates strong values on first boot and persists them in the runtime volume.

APP_URL=https://procureflow.example.com
# Optional but recommended for explicit control:
AUTH_SECRET=replace-with-openssl-rand-base64-32
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
INTERNAL_API_TOKEN=replace-with-another-long-random-value
SEED_DEMO_DATA=true
EMAIL_FROM=procureflow@example.com
# Procurement assistant. Ollama must be reachable from the assistant container.
ASSISTANT_INTERNAL_TOKEN=replace-with-a-long-random-value
ASSISTANT_MODEL=phi4-mini:3.8b
ASSISTANT_MODEL_QUANTIZATION=Q4_K_M
ASSISTANT_LLM_BASE_URL=http://host.docker.internal:11434/v1

