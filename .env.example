# ---------------------------------------------------------------------------
# ProcureFlow environment (copy to .env for local development)
# Never commit real secrets. See README "Environment" for details.
# ---------------------------------------------------------------------------

# Postgres. Local Docker/portable Postgres uses the same values as docker-compose.yml.
# Neon: DATABASE_URL is the pooled connection string, DIRECT_URL is the direct one
# used by migrations. Both must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://procureflow:procureflow@localhost:5432/procureflow"
DIRECT_URL="postgresql://procureflow:procureflow@localhost:5432/procureflow"
# Set to "true" for Neon (or when your Postgres requires SSL).
DATABASE_SSL="false"
# Set to "true" when DATABASE_URL points at a PgBouncer/Neon pooled endpoint.
DATABASE_POOLED="false"

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-0000000000000000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Workflow engine connection. These values are the only switch needed between
# the local engine, the stock engine CLI, a self-hosted engine and a managed
# workflow service.
WORKFLOW_ENGINE_ADDRESS="127.0.0.1:7233"
WORKFLOW_ENGINE_NAMESPACE="default"
WORKFLOW_ENGINE_TASK_QUEUE="procureflow"
# Managed/TLS endpoints:
WORKFLOW_ENGINE_TLS="false"
WORKFLOW_ENGINE_API_KEY=""
# Optional: engine inspector/UI base URL (not required by the app).
WORKFLOW_ENGINE_UI_URL="http://localhost:8233"
# Optional ports used by the local engine scripts.
WORKFLOW_ENGINE_PORT="7233"
WORKFLOW_ENGINE_UI_PORT="8233"

# Set to "true" only when the local engine (`pnpm engine:dev`) is serving this
# deployment and has provisioned the ProcureFlow search attributes. Keep "false"
# for the stock engine or a managed service. `pnpm dev` enables it for the local rework.
WORKFLOW_ENGINE_SEARCH_ATTRIBUTES="false"

# Feature flags for app-side extension points (safe defaults for production).
PROCUREFLOW_AUDIT_INTERCEPTOR_ENABLED="true"
PROCUREFLOW_WORKER_PLUGIN_ENABLED="true"

# Integrations. Local implementations work with no configuration.
EMAIL_ADAPTER="console"            # console | resend
EMAIL_FROM="procureflow@example.com"
RESEND_API_KEY=""
SLACK_WEBHOOK_URL=""               # empty = no-op
ERP_ADAPTER="csv"                  # csv | noop
ERP_CSV_DIR=".data/erp"
STORAGE_ADAPTER="local"            # local | noop
STORAGE_DIR=".data/storage"
AI_RISK_SUMMARY_ENABLED="true"     # deterministic local summary, no network

# Protects /api/internal/* endpoints (outbox processing). Generate for prod.
INTERNAL_API_TOKEN="dev-internal-token-change-me"

# Web
PORT="3000"
NODE_ENV="development"
